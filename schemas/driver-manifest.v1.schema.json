{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/interactive-project/simulation/blob/main/schemas/driver-manifest.v1.schema.json",
  "type": "object",
  "properties": {
    "driverVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
          },
          "modelVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "stateVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "dimensions": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                0,
                2,
                3
              ]
            }
          },
          "units": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
            }
          }
        },
        "required": [
          "id",
          "modelVersion",
          "stateVersion",
          "dimensions",
          "units"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "interactive": {
          "type": "boolean"
        },
        "evaluable": {
          "type": "boolean"
        },
        "collaborative": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "deterministic": {
          "type": "boolean"
        },
        "resumable": {
          "type": "boolean"
        },
        "aiGeneratable": {
          "type": "boolean"
        }
      },
      "required": [
        "interactive",
        "evaluable",
        "collaborative",
        "offline",
        "deterministic",
        "resumable",
        "aiGeneratable"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "properties": {
        "step": {
          "type": "boolean"
        },
        "input": {
          "type": "boolean"
        },
        "reset": {
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "input",
        "reset"
      ],
      "additionalProperties": false
    },
    "requiredPermissions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "execution",
          "network",
          "media"
        ]
      }
    }
  },
  "required": [
    "driverVersion",
    "id",
    "models",
    "capabilities",
    "operations",
    "requiredPermissions"
  ],
  "additionalProperties": false
}
